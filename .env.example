# Local Service Hub only listens on localhost.
SERVICE_HUB_HOST=127.0.0.1
SERVICE_HUB_PORT=8750

# Process Compose REST API. Keep the token itself in the ignored token file.
PROCESS_COMPOSE_URL=http://127.0.0.1:8751
PROCESS_COMPOSE_TOKEN_FILE=runtime/process-compose.token
SERVICES_PATH=services.json
PROCESS_COMPOSE_GENERATED_PATH=process-compose.generated.yaml
